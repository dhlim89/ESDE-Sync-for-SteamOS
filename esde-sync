#!/usr/bin/env python3
"""One launcher, one backend, one live app-window session."""
import ast, fcntl, json, os, pathlib, shutil, subprocess, sys, time, urllib.request


def main():
    home=pathlib.Path.home(); os.chdir(home)
    test_mode=os.environ.get('ESDE_SYNC_TEST_MODE')=='1'
    app=pathlib.Path(__file__).resolve().parent if test_mode else home/'.local/share/esde-sync'
    state=pathlib.Path(os.environ.get('XDG_STATE_HOME',home/'.local/state'))/'esde-sync'
    if test_mode:
        test_root=pathlib.Path(os.environ['ESDE_SYNC_TEST_ROOT']).resolve()
        if not test_root.is_relative_to(pathlib.Path('/tmp')) or test_root==pathlib.Path('/tmp'):
            raise RuntimeError('test root는 /tmp 하위의 전용 디렉터리여야 합니다.')
        state=test_root/'state/esde-sync'
    state.mkdir(parents=True,exist_ok=True)
    tree=ast.parse((app/'esde-sync-gui.py').read_text(encoding='utf-8'))
    expected_version=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='APP_VERSION' for t in n.targets))
    page='dropbox' if '--page=dropbox' in sys.argv else 'android'
    opener=urllib.request.build_opener(urllib.request.ProxyHandler({}))
    def call(url,path,data=None):
        request=urllib.request.Request(url+path,data=json.dumps(data).encode() if data is not None else None,
                                      headers={'Content-Type':'application/json'})
        with opener.open(request,timeout=2) as response: return json.load(response)
    def ready():
        port=int((state/'gui-port').read_text().strip())
        if not 1<=port<=65535: raise ValueError('잘못된 gui-port')
        url=f'http://127.0.0.1:{port}/'
        health=call(url,'api/health')
        if health.get('ok') is not True or health.get('version')!=expected_version or not health.get('instance_id'):
            raise RuntimeError('통합 backend가 준비되지 않았습니다.')
        return url
    with (state/'launch.lock').open('a+') as held:
        fcntl.flock(held,fcntl.LOCK_EX)
        try: url=ready()
        except Exception:
            backend=subprocess.Popen([sys.executable,str(app/'esde-sync-gui.py'),'--no-browser'],
                 cwd=str(home),stdin=subprocess.DEVNULL,start_new_session=True)
            deadline=time.monotonic()+30
            while True:
                try: url=ready(); break
                except Exception:
                    if backend.poll() is not None or time.monotonic()>deadline:
                        raise RuntimeError('ES-DE Sync backend 연결에 실패했습니다.')
                    time.sleep(.2)
        status=call(url,'api/app/activate',{'page':page})
        if status['window_alive']:
            if shutil.which('wmctrl'):
                subprocess.run(['wmctrl','-xa','esde-sync'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            return
        candidates=[str(home/'Applications/Brave-Origin/brave'),'brave','brave-browser']
        command=next((c for c in candidates if (os.path.isabs(c) and os.access(c,os.X_OK)) or (not os.path.isabs(c) and shutil.which(c))),None)
        if command is None:
            call(url,'api/app/launch-failed',{})
            raise RuntimeError('Brave를 찾을 수 없습니다. 앱 창을 열지 못했습니다.')
        browser_args=[command,'--app='+url,'--class=esde-sync','--no-first-run','--no-default-browser-check']
        if test_mode:
            browser_args += ['--user-data-dir='+str(test_root/'brave-profile'),'--remote-debugging-port=0','--remote-debugging-address=127.0.0.1']
        try:
            subprocess.Popen(browser_args,
                             stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
        except Exception:
            call(url,'api/app/launch-failed',{})
            raise


if __name__=='__main__':
    try: main()
    except Exception as error:
        print('LAUNCH ERROR: '+str(error),file=sys.stderr); sys.exit(1)
