validate_runtime_path_map() {
  local serial="$1" map_file="$2" systems="$3"
  [[ -e "$map_file" || -L "$map_file" ]] || return 0
  python3 - "$serial" "$map_file" "$systems" >>"$LOG_FILE" 2>&1 <<'PY'
import json, pathlib, re, sys

serial, filename, configured_systems = sys.argv[1:4]
path = pathlib.Path(filename)
try:
    if path.is_symlink() or not path.is_file():
        raise ValueError("매핑 경로는 일반 파일이어야 합니다.")
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict) or set(data) != {"schema_version", "device_serial", "systems"}:
        raise ValueError("최상위 스키마 키가 잘못되었습니다.")
    if type(data["schema_version"]) is not int or data["schema_version"] != 1:
        raise ValueError("지원하지 않는 schema_version입니다.")
    if not isinstance(data["device_serial"], str) or data["device_serial"] != serial:
        raise ValueError("매핑 device_serial이 현재 기기와 다릅니다.")
    if not isinstance(data["systems"], dict):
        raise ValueError("systems는 객체여야 합니다.")
    enabled = set(configured_systems.split())
    if not set(data["systems"]).issubset(enabled):
        raise ValueError("현재 프로필에 없는 시스템의 매핑이 포함되어 있습니다.")
    for system, rows in data["systems"].items():
        if not isinstance(system, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", system):
            raise ValueError("시스템 키가 잘못되었습니다.")
        if not isinstance(rows, list):
            raise ValueError(f"{system}: 매핑은 배열이어야 합니다.")
        sources, destinations = set(), set()
        for row in rows:
            if not isinstance(row, dict) or set(row) != {"from", "to"}:
                raise ValueError(f"{system}: 매핑 항목 스키마가 잘못되었습니다.")
            old, new = row["from"], row["to"]
            for label, value in (("from", old), ("to", new)):
                if not isinstance(value, str) or not value.startswith("./") or value == "./" or value != value.strip() or "\0" in value:
                    raise ValueError(f"{system}: {label} 경로가 잘못되었습니다.")
            if old == new:
                raise ValueError(f"{system}: from과 to가 같습니다.")
            if old in sources or new in destinations:
                raise ValueError(f"{system}: from/to 중복 또는 다대일·일대다 매핑입니다.")
            sources.add(old)
            destinations.add(new)
        if sources & destinations:
            raise ValueError(f"{system}: 연쇄 또는 순환 매핑은 허용되지 않습니다.")
except (OSError, UnicodeError, json.JSONDecodeError, ValueError, TypeError) as exc:
    print(f"RUNTIME PATH MAP INVALID: {exc}", file=sys.stderr)
    raise SystemExit(1)
PY
}

transform_gamelist() {
  local input="$1" output="$2" mapping="$3" count_file="$4" system="$5" removed_file="$6" remote_input="${7:-}" runtime_map_file="${8:-}" serial="${9:-}"
  python3 - "$input" "$output" "$mapping" "$count_file" "$system" "$removed_file" "$remote_input" "$runtime_map_file" "$serial" >>"$LOG_FILE" 2>&1 <<'PY'
import sys, re, copy
import json, pathlib
import xml.etree.ElementTree as ET

src, dst, mapping_text, count_file, system, removed_file, remote_input, runtime_map_file, serial = sys.argv[1:10]

mapping = {}
if mapping_text.strip():
    for item in mapping_text.split("||"):
        if "=>" in item:
            old, new = item.split("=>", 1)
            mapping[old] = new

with open(src, "r", encoding="utf-8-sig", newline="") as f:
    text = f.read()

def parse_fragments(raw):
    # Keep the existing XML declaration + synthetic-root fragment support.
    raw = re.sub(r"<\?xml[^>]*\?>", "", raw).strip()
    if not raw:
        raise ValueError("gamelist가 비어 있습니다.")
    parser = ET.XMLParser(target=ET.TreeBuilder(insert_comments=True))
    return ET.fromstring(f"<synthetic>{raw}</synthetic>", parser=parser)


def game_index(root):
    games = {}
    for top in list(root):
        entries = list(top) if top.tag == "gameList" else [top]
        for entry in entries:
            if entry.tag != "game":
                continue
            path = (entry.findtext("path") or "").strip()
            if not path or path in games:
                raise ValueError(f"game path가 없거나 중복되었습니다: {path!r}")
            games[path] = entry
    return games


def field_bytes(field):
    field = copy.deepcopy(field)
    field.tail = None
    return ET.tostring(field, encoding="utf-8")


def runtime_path_mappings(filename, selected_serial, selected_system):
    if not filename:
        return []
    path = pathlib.Path(filename)
    if not path.exists() and not path.is_symlink():
        return []
    if path.is_symlink() or not path.is_file():
        raise ValueError("runtime path mapping은 일반 파일이어야 합니다.")
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict) or set(data) != {"schema_version", "device_serial", "systems"}:
        raise ValueError("runtime path mapping 최상위 스키마가 잘못되었습니다.")
    if type(data["schema_version"]) is not int or data["schema_version"] != 1:
        raise ValueError("지원하지 않는 runtime path mapping schema_version입니다.")
    if not isinstance(data["device_serial"], str) or data["device_serial"] != selected_serial:
        raise ValueError("runtime path mapping serial이 현재 기기와 다릅니다.")
    systems = data["systems"]
    if not isinstance(systems, dict):
        raise ValueError("runtime path mapping systems가 객체가 아닙니다.")
    if selected_system not in systems:
        return []
    rows = systems[selected_system]
    if not isinstance(rows, list):
        raise ValueError("runtime path mapping 시스템 항목이 배열이 아닙니다.")
    result, sources, destinations = [], set(), set()
    for row in rows:
        if not isinstance(row, dict) or set(row) != {"from", "to"}:
            raise ValueError("runtime path mapping 항목 스키마가 잘못되었습니다.")
        old, new = row["from"], row["to"]
        for label, value in (("from", old), ("to", new)):
            if not isinstance(value, str) or not value.startswith("./") or value == "./" or value != value.strip() or "\0" in value:
                raise ValueError(f"runtime path mapping {label} 경로가 잘못되었습니다.")
        if old == new or old in sources or new in destinations or old in destinations or new in sources:
            raise ValueError("runtime path mapping이 중복·다대일·일대다·연쇄 관계입니다.")
        sources.add(old); destinations.add(new); result.append((old, new))
    return result


master = parse_fragments(text)
master_games = game_index(master)
runtime_merged = False
system_default_merged = False
if remote_input:
    with open(remote_input, "r", encoding="utf-8-sig", newline="") as f:
        android_root = parse_fragments(f.read())
        android_games = game_index(android_root)
    # System defaults are siblings of gameList, never game-level altemulator.
    android_defaults = android_root.findall("alternativeEmulator")
    legion_defaults = master.findall("alternativeEmulator")
    if len(android_defaults) > 1 or len(legion_defaults) > 1:
        raise ValueError("system-level alternativeEmulator가 중복되었습니다.")
    # Presence matters: an explicitly empty Android default is preserved too.
    if android_defaults:
        android_default = android_defaults[0]
        if not legion_defaults or field_bytes(legion_defaults[0]) != field_bytes(android_default):
            position = list(master).index(legion_defaults[0]) if legion_defaults else 0
            field = copy.deepcopy(android_default)
            if legion_defaults:
                field.tail = legion_defaults[0].tail
                master.remove(legion_defaults[0])
            master.insert(position, field)
            system_default_merged = True
    for path, game in master_games.items():
        android = android_games.get(path)
        if android is None:
            continue
        for tag in ("playcount", "playtime", "lastplayed"):
            android_fields = android.findall(tag)
            if len(android_fields) > 1:
                raise ValueError(f"Android runtime 태그가 중복되었습니다: {path!r} {tag}")
            # Test tag presence, never truthiness: zero and empty values belong
            # to Android too. Only an absent tag falls back to Legion.
            if not android_fields:
                continue
            legion_fields = game.findall(tag)
            if len(legion_fields) == 1 and field_bytes(legion_fields[0]) == field_bytes(android_fields[0]):
                continue
            position = list(game).index(legion_fields[0]) if legion_fields else len(game)
            tail = legion_fields[0].tail if legion_fields else android_fields[0].tail
            for field in legion_fields:
                game.remove(field)
            field = copy.deepcopy(android_fields[0])
            field.tail = tail
            game.insert(position, field)
            runtime_merged = True
    # A rename migration copies only Android runtime fields. The path and all
    # descriptive metadata continue to come from the SteamOS master gamelist.
    for old_path, new_path in runtime_path_mappings(runtime_map_file, serial, system):
        old_game = android_games.get(old_path)
        # An absent source is normal after a successful prior migration. A
        # source still present in SteamOS is not treated as a rename.
        if old_game is None or old_path in master_games:
            continue
        new_game = master_games.get(new_path)
        if new_game is None:
            raise ValueError(f"runtime path mapping 대상이 SteamOS gamelist에 없습니다: {new_path!r}")
        destination_android = android_games.get(new_path)
        for tag in ("playcount", "playtime", "lastplayed"):
            old_fields = old_game.findall(tag)
            if len(old_fields) > 1:
                raise ValueError(f"이전 경로의 Android runtime 태그가 중복되었습니다: {old_path!r} {tag}")
            if not old_fields:
                continue
            destination_fields = destination_android.findall(tag) if destination_android is not None else []
            if len(destination_fields) > 1:
                raise ValueError(f"대상 경로의 Android runtime 태그가 중복되었습니다: {new_path!r} {tag}")
            if destination_fields:
                if field_bytes(destination_fields[0]) != field_bytes(old_fields[0]):
                    raise ValueError(f"runtime path mapping 충돌: {old_path!r} -> {new_path!r} <{tag}>")
                continue
            legion_fields = new_game.findall(tag)
            if len(legion_fields) > 1:
                raise ValueError(f"SteamOS 대상 runtime 태그가 중복되었습니다: {new_path!r} {tag}")
            position = list(new_game).index(legion_fields[0]) if legion_fields else len(new_game)
            tail = legion_fields[0].tail if legion_fields else old_fields[0].tail
            for field in legion_fields:
                new_game.remove(field)
            migrated = copy.deepcopy(old_fields[0])
            migrated.tail = tail
            new_game.insert(position, migrated)
            runtime_merged = True
    # Android-only games are intentionally never appended to the master tree.
    if runtime_merged or system_default_merged:
        text = "".join(ET.tostring(child, encoding="unicode", short_empty_elements=False) for child in list(master))

changed = 0
removed = 0

def repl(m):
    global changed, removed
    value = m.group(1)

    # Arcade keeps every altemulator exactly as-is.
    if system == "arcade":
        return m.group(0)

    # Other systems:
    # 1) Standalone entries are kept, and mapped when a device mapping exists.
    if "(Standalone)" in value:
        if value in mapping:
            changed += 1
            return f"<altemulator>{mapping[value]}</altemulator>"
        return m.group(0)

    # 2) Non-Standalone entries are RetroArch-core selections and are removed
    #    from the Android-bound temporary gamelist.
    removed += 1
    return ""

result = re.sub(r"<altemulator>(.*?)</altemulator>", repl, text, flags=re.DOTALL)

# Preserve original bytes when nothing changed, avoiding needless formatting churn.
if not runtime_merged and not system_default_merged and changed == 0 and removed == 0:
    with open(src, "rb") as fsrc, open(dst, "wb") as fdst:
        fdst.write(fsrc.read())
else:
    with open(dst, "w", encoding="utf-8", newline="") as f:
        f.write(result)

with open(count_file, "w", encoding="ascii") as f:
    f.write(str(changed))
with open(removed_file, "w", encoding="ascii") as f:
    f.write(str(removed))
PY
}

read_remote_gamelist() {
  local serial="$1" remote="$2" output="$3" response quoted parsed
  response="$TMP_DIR/gamelist-response-${BASHPID}-${RANDOM}.bin"
  quoted="$(remote_shell_quote "$remote")"
  # Status is carried in stdout; do not infer it from adb's remote exit code.
  adb -s "$serial" exec-out "
    p=$quoted
    if [ ! -e \"\$p\" ]; then
      [ ! -L \"\$p\" ] || { printf 'ESDE_GL_V1 ERROR\\n'; exit 0; }
      parent=\${p%/*}
      if [ -e \"\$parent\" ]; then
        [ -d \"\$parent\" ] && [ -r \"\$parent\" ] && [ -x \"\$parent\" ] || { printf 'ESDE_GL_V1 ERROR\\n'; exit 0; }
      fi
      printf 'ESDE_GL_V1 MISSING\\n'; exit 0
    fi
    if [ ! -f \"\$p\" ]; then printf 'ESDE_GL_V1 ERROR\\n'; exit 0; fi
    n=\$(stat -c %s \"\$p\" 2>/dev/null) || { printf 'ESDE_GL_V1 ERROR\\n'; exit 0; }
    case \"\$n\" in ''|*[!0-9]*) printf 'ESDE_GL_V1 ERROR\\n'; exit 0;; esac
    [ \"\$n\" != 0 ] || { printf 'ESDE_GL_V1 EMPTY\\n'; exit 0; }
    printf 'ESDE_GL_V1 FILE %s\\n' \"\$n\"
    cat \"\$p\" || exit 0
    printf '\\nESDE_GL_V1_END\\n'
  " </dev/null >"$response" 2>>"$LOG_FILE" || true
  parsed="$(python3 - "$response" "$output" <<'PY'
import pathlib, re, sys
raw = pathlib.Path(sys.argv[1]).read_bytes()
missing = b"ESDE_GL_V1 MISSING\n"
if raw == missing:
    pathlib.Path(sys.argv[2]).unlink(missing_ok=True)
    print("MISSING")
    raise SystemExit(0)
if raw == b"ESDE_GL_V1 EMPTY\n":
    print("EMPTY")
    raise SystemExit(0)
if raw == b"ESDE_GL_V1 ERROR\n":
    print("ERROR")
    raise SystemExit(0)
match = re.match(rb"ESDE_GL_V1 FILE ([0-9]+)\n", raw)
if not match:
    print("ERROR")
    raise SystemExit(0)
size = int(match.group(1))
payload_start = match.end()
trailer = b"\nESDE_GL_V1_END\n"
payload_end = payload_start + size
if size == 0:
    print("EMPTY")
    raise SystemExit(0)
if len(raw) != payload_end + len(trailer) or raw[payload_end:] != trailer:
    print("ERROR")
    raise SystemExit(0)
pathlib.Path(sys.argv[2]).write_bytes(raw[payload_start:payload_end])
print("FILE")
PY
)"
  rm -f "$response"
  case "$parsed" in
    MISSING) rm -f "$output"; return 0 ;;
    FILE) return 0 ;;
    EMPTY|ERROR) rm -f "$output"; printf 'GAMELIST READ %s: %s\n' "$parsed" "$remote" >>"$LOG_FILE"; return 1 ;;
    *) rm -f "$output"; printf 'GAMELIST READ INVALID RESPONSE: %s\n' "$remote" >>"$LOG_FILE"; return 1 ;;
  esac
}

xml_semantic_equal() {
  local left="$1" right="$2"
  python3 - "$left" "$right" >>"$LOG_FILE" 2>&1 <<'PY'
import sys
import re
import xml.etree.ElementTree as ET

def text(v):
    return (v or "").strip()

def parse_fragments(path):
    raw = open(path, "r", encoding="utf-8-sig", errors="replace").read()
    raw = re.sub(r"<\?xml[^>]*\?>", "", raw).strip()
    # Wrap possibly multiple top-level fragments in a synthetic root.
    wrapped = f"<synthetic>{raw}</synthetic>"
    return ET.fromstring(wrapped)

def canonical_entry(elem):
    attrs = tuple(sorted((k, text(v)) for k, v in elem.attrib.items()))
    children = []
    for child in list(elem):
        cattrs = tuple(sorted((k, text(v)) for k, v in child.attrib.items()))
        nested = tuple(sorted(canonical_entry(x) for x in list(child))) if list(child) else ()
        children.append((child.tag, text(child.text), cattrs, nested))
    children.sort()
    return (elem.tag, attrs, tuple(children))

def canonical_doc(path):
    root = parse_fragments(path)
    items = []
    for top in list(root):
        # If top-level item is a gamelist wrapper, compare its children.
        if top.tag == "gameList":
            for e in list(top):
                items.append(canonical_entry(e))
        else:
            items.append(canonical_entry(top))
    items.sort()
    return tuple(items)

try:
    a = canonical_doc(sys.argv[1])
    b = canonical_doc(sys.argv[2])
except Exception as e:
    print(f"GAMELIST CANONICALIZE ERROR: {e}", file=sys.stderr)
    sys.exit(2)

sys.exit(0 if a == b else 1)
PY
}


xml_semantic_diff() {
  local left="$1" right="$2" system="$3" out="$4"
  python3 - "$left" "$right" "$system" "$out" >>"$LOG_FILE" 2>&1 <<'PY'
import sys
import re
import xml.etree.ElementTree as ET
from collections import defaultdict

left, right, system, out = sys.argv[1:5]

def norm(v):
    return (v or "").strip()

def parse_fragments(path):
    raw = open(path, "r", encoding="utf-8-sig", errors="replace").read()
    raw = re.sub(r"<\?xml[^>]*\?>", "", raw).strip()
    wrapped = f"<synthetic>{raw}</synthetic>"
    return ET.fromstring(wrapped)

def entries(path):
    root = parse_fragments(path)
    result = {}
    tops = []
    for top in list(root):
        if top.tag == "gameList":
            tops.extend(list(top))
        else:
            tops.append(top)
    for elem in tops:
        p = elem.find("path")
        key = (elem.tag, norm(p.text if p is not None else ""))
        values = defaultdict(list)
        for child in list(elem):
            values[child.tag].append(norm(child.text))
        result[key] = {k: tuple(sorted(v)) for k, v in values.items()}
    return result

def key_text(k):
    typ, path = k
    return f"{typ}:{path or '(path 없음)'}"

try:
    legion = entries(left)
    pocket = entries(right)
except Exception as exc:
    with open(out, "w", encoding="utf-8") as f:
        f.write(f"[{system}] XML 파싱 오류: {exc}\n")
    sys.exit(0)

lines = []
for key in sorted(set(legion) | set(pocket)):
    if key not in legion:
        lines.append(f"[{system}] Pocket에만 항목 존재: {key_text(key)}")
        continue
    if key not in pocket:
        lines.append(f"[{system}] Legion에만 항목 존재: {key_text(key)}")
        continue

    for tag in sorted(set(legion[key]) | set(pocket[key])):
        lv = legion[key].get(tag, ())
        pv = pocket[key].get(tag, ())
        if lv != pv:
            lines.append(
                f"[{system}] {key_text(key)} / <{tag}> | "
                f"Legion={lv!r} | Pocket={pv!r}"
            )

limit = 30
shown = lines[:limit]
if len(lines) > limit:
    shown.append(f"… 외 {len(lines)-limit}개 차이")

with open(out, "w", encoding="utf-8") as f:
    if shown:
        f.write("\n".join(shown) + "\n")
    else:
        f.write(f"[{system}] 구조 비교상 차이 항목을 찾지 못함\n")
PY
}

list_altemulator_games() {
  local input="$1" system="$2" out="$3"
  python3 - "$input" "$system" "$out" >>"$LOG_FILE" 2>&1 <<'PY'
import sys
import re
import xml.etree.ElementTree as ET

path, system, out = sys.argv[1:4]

def norm(v):
    return (v or "").strip()

raw = open(path, "r", encoding="utf-8-sig", errors="replace").read()
raw = re.sub(r"<\?xml[^>]*\?>", "", raw).strip()
root = ET.fromstring(f"<synthetic>{raw}</synthetic>")

tops = []
for top in list(root):
    if top.tag == "gameList":
        tops.extend(list(top))
    else:
        tops.append(top)

rows = []
for elem in tops:
    if elem.tag not in ("game", "folder"):
        continue
    alt = elem.find("altemulator")
    if alt is None or not norm(alt.text):
        continue
    p = elem.find("path")
    n = elem.find("name")
    rows.append((
        norm(p.text if p is not None else ""),
        norm(n.text if n is not None else ""),
        norm(alt.text),
    ))

rows.sort(key=lambda x: (x[0], x[1], x[2]))
with open(out, "w", encoding="utf-8") as f:
    for p, n, alt in rows:
        label = n or p or "(이름 없음)"
        f.write(f"[{system}] {label} | {p} | {alt}\n")
PY
}


pull_remote_file() {
  local serial="$1" remote="$2" local_out="$3"
  local escaped="${remote//\'/\'\\\'\'}"
  adb -s "$serial" exec-out "cat '$escaped' 2>/dev/null" </dev/null > "$local_out"
}

stop_esde() {
  local serial="$1" package="$2"
  adb -s "$serial" shell am force-stop "$package" </dev/null >>"$LOG_FILE" 2>&1
  sleep 1
}

start_esde() {
  local serial="$1" activity="$2"
  adb -s "$serial" shell am start -n "$activity" </dev/null >>"$LOG_FILE" 2>&1
}

adb_connection_alive() {
  local state
  state="$(adb -s "$1" get-state </dev/null 2>/dev/null | tr -d '\r')" || return 1
  [[ "$state" == "device" ]]
}

build_remote_index() {
  local serial="$1" system="$2" remote_root="$3" out="$4"
  local remote_dir="$remote_root/$system" response quoted
  response="$out.response"
  quoted="$(remote_shell_quote "$remote_dir")"
  adb -s "$serial" exec-out "
    p=$quoted
    if [ ! -e \"\$p\" ]; then
      parent=\${p%/*}
      if [ -e \"\$parent\" ]; then
        if [ ! -d \"\$parent\" ] || [ ! -r \"\$parent\" ] || [ ! -x \"\$parent\" ]; then
          printf 'ESDE_INDEX_V2 ERROR\\n'; exit 0
        fi
      fi
      printf 'ESDE_INDEX_V2 MISSING\\n'; exit 0
    fi
    if [ ! -d \"\$p\" ] || [ ! -r \"\$p\" ] || [ ! -x \"\$p\" ]; then printf 'ESDE_INDEX_V2 ERROR\\n'; exit 0; fi
    printf 'ESDE_INDEX_V2 BEGIN\\n'
    find \"\$p\" -type f -exec sh -c '
      f=\$1
      size=\$(stat -c %s \"\$f\" 2>/dev/null)
      if [ \$? -ne 0 ]; then printf \"ESDE_INDEX_V2 ITEM_ERROR\\n\"; exit 0; fi
      case \$size in \"\"|*[!0-9]*) printf \"ESDE_INDEX_V2 ITEM_ERROR\\n\"; exit 0;; esac
      length=\$(printf \"%s\" \"\$f\" | wc -c | tr -d \"[:space:]\")
      if [ \$? -ne 0 ]; then printf \"ESDE_INDEX_V2 ITEM_ERROR\\n\"; exit 0; fi
      case \$length in \"\"|*[!0-9]*) printf \"ESDE_INDEX_V2 ITEM_ERROR\\n\"; exit 0;; esac
      printf \"F %s %s\\n\" \"\$length\" \"\$size\"
      printf \"%s\" \"\$f\"
    ' sh {} \\; 2>/dev/null
    rc=\$?
    if [ \"\$rc\" -eq 0 ]; then printf 'ESDE_INDEX_V2 END\\n'; else printf 'ESDE_INDEX_V2 ERROR\\n'; fi
  " </dev/null >"$response" 2>>"$LOG_FILE" || true
  if ! python3 - "$response" "$out" "$remote_root/" <<'PY'
import os, pathlib, re, sys
raw = pathlib.Path(sys.argv[1]).read_bytes()
out = pathlib.Path(sys.argv[2])
prefix = os.fsencode(sys.argv[3])
rows, seen = [], set()
if raw == b"ESDE_INDEX_V2 MISSING\n":
    out.write_bytes(b"")
    raise SystemExit(0)
start = b"ESDE_INDEX_V2 BEGIN\n"
if not raw.startswith(start): raise SystemExit(1)
pos = len(start)
while True:
    nl = raw.find(b"\n", pos, min(len(raw), pos + 128))
    if nl < 0: raise SystemExit(1)
    header = raw[pos:nl]
    if header == b"ESDE_INDEX_V2 END":
        pos = nl + 1
        break
    match = re.fullmatch(rb"F ([0-9]+) ([0-9]+)", header)
    if not match: raise SystemExit(1)
    path_len, size = int(match.group(1)), match.group(2)
    if path_len < 1 or path_len > 16 * 1024 * 1024: raise SystemExit(1)
    pos = nl + 1
    end = pos + path_len
    if end > len(raw): raise SystemExit(1)
    path = raw[pos:end]
    if not path.startswith(prefix) or len(path) == len(prefix) or b"\0" in path: raise SystemExit(1)
    rel = path[len(prefix):]
    if rel in seen: raise SystemExit(1)
    seen.add(rel)
    rows.append(rel + b"\0" + size + b"\0")
    pos = end
if pos != len(raw): raise SystemExit(1)
out.write_bytes(b"".join(rows))
PY
  then
    rm -f "$response" "$out"
    printf 'REMOTE INDEX INVALID: %s\n' "$remote_dir" >>"$LOG_FILE"
    return 1
  fi
  rm -f "$response"
  return 0
}

append_changes() {
  local label="$1"
  local max_show="$2"
  shift 2
  local -a items=("$@")
  local total="${#items[@]}"
  local out="" i=0 item

  (( total == 0 )) && { printf ''; return; }

  out+="
$label"
  for item in "${items[@]}"; do
    out+="
$item"
    ((i++))
    if (( i >= max_show )); then
      if (( total > max_show )); then
        out+="
… 외 $((total-max_show))개"
      fi
      break
    fi
  done

  printf '%s' "$out"
}

main() {
  : > "$LOG_FILE"
  if [[ "$GUI_MODE" == "1" ]]; then
    rm -f "$GUI_RESULT_FILE"
    gui_status 0 1 "준비 중…"
  fi

  command -v adb >/dev/null 2>&1 || { error "adb를 찾을 수 없습니다."; exit 1; }
  command -v sha256sum >/dev/null 2>&1 || { error "sha256sum을 찾을 수 없습니다."; exit 1; }
  command -v python3 >/dev/null 2>&1 || { error "python3를 찾을 수 없습니다."; exit 1; }

  local count serial model manufacturer safe_serial profile
  count="$(adb_device_count)"
  if [[ "$count" -eq 0 ]]; then error "USB 디버깅이 허용된 Android 기기를 찾지 못했습니다."; exit 1
  elif [[ "$count" -gt 1 ]]; then error "Android 기기가 2대 이상 연결되어 있습니다. 한 번에 한 대만 연결해 주세요."; exit 1
  fi

  serial="$(first_device_serial)"
  model="$(get_prop "$serial" ro.product.model)"
  manufacturer="$(get_prop "$serial" ro.product.manufacturer)"
  safe_serial="$(sanitize "$serial")"
  profile="$PROFILE_DIR/${safe_serial}.conf"

  [[ -f "$profile" ]] || { error "기기 프로필을 찾을 수 없습니다: $profile"; exit 1; }

  source "$profile"

  LOCAL_GAMELIST_ROOT="${LOCAL_GAMELIST_ROOT:-$HOME/ES-DE/gamelists}"
  REMOTE_GAMELIST_ROOT="${REMOTE_GAMELIST_ROOT:-/storage/emulated/0/ES-DE/gamelists}"
  LOCAL_MEDIA_ROOT="${LOCAL_MEDIA_ROOT:-$HOME/Emulation/tools/downloaded_media}"
  REMOTE_MEDIA_ROOT="${REMOTE_MEDIA_ROOT:-/storage/emulated/0/ES-DE/downloaded_media}"
  SYNC_GAMELISTS="${SYNC_GAMELISTS:-1}"
  SYNC_MEDIA="${SYNC_MEDIA:-1}"
  MIRROR_ROMS="${MIRROR_ROMS:-1}"
  MIRROR_MEDIA="${MIRROR_MEDIA:-1}"
  ALTEMU_MAP_GB="${ALTEMU_MAP_GB:-}"
  ALTEMU_MAP_GBC="${ALTEMU_MAP_GBC:-}"
  ESDE_PACKAGE="${ESDE_PACKAGE:-$ESDE_PACKAGE_DEFAULT}"
  ESDE_ACTIVITY="${ESDE_ACTIVITY:-$ESDE_ACTIVITY_DEFAULT}"
  MANAGE_ESDE="${MANAGE_ESDE:-1}"

  ALTEMU_MAP_GB="${ALTEMU_MAP_GB//SameBoy (Standalone)/Sameboy (Standalone)}"
  ALTEMU_MAP_GBC="${ALTEMU_MAP_GBC//SameBoy (Standalone)/Sameboy (Standalone)}"

  local runtime_map_file="$PROFILE_DIR/${safe_serial}.runtime-map.json"
  if ! validate_runtime_path_map "$serial" "$runtime_map_file" "$SYSTEMS"; then
    printf 'RUNTIME PATH MAP INVALID; no remote changes started: %s\n' "$runtime_map_file" >>"$LOG_FILE"
    error "기기별 runtime 경로 매핑 파일이 잘못되었습니다: $runtime_map_file"
    exit 1
  fi

  local rom_copied=0 rom_same=0 rom_failed=0 rom_deleted=0 ignored=0
  local gl_copied=0 gl_same=0 gl_failed=0 gl_transformed=0 gl_alt_removed=0
  local media_copied=0 media_same=0 media_failed=0 media_deleted=0 media_total=0 media_seen=0
  local system file rel rsize mapping
  local media_index_ok
  local local_gl remote_gl temp_gl remote_temp_gl diff_file alt_list_file count_file removed_file changed removed rom_index_ok
  local media_dir index_file rom_index_file local_rom_index local_media_index
  local -a rom_copied_files=()
  local -a rom_deleted_files=()
  local -a gamelist_copied_files=()
  local -a gamelist_diff_reports=()
  local -a altemulator_games=()
  local -a media_copied_files=()
  local -a media_deleted_files=()
  local -a rom_recovery_reports=()
  local rom_abort=0
  ADB_DISCONNECTED=0

  local total_work=2
  for system in $SYSTEMS; do
    if [[ -d "$LOCAL_ROM_ROOT/$system" ]]; then
      while IFS= read -r -d '' file; do is_rom_file "$file" && ((total_work++)); done < <(find "$LOCAL_ROM_ROOT/$system" -type f -print0)
    fi
    [[ "$SYNC_GAMELISTS" == "1" && -f "$LOCAL_GAMELIST_ROOT/$system/gamelist.xml" ]] && ((total_work++))
    if [[ "$SYNC_MEDIA" == "1" && -d "$LOCAL_MEDIA_ROOT/$system" ]]; then
      while IFS= read -r -d '' file; do ((total_work++)); ((media_total++)); done < <(find "$LOCAL_MEDIA_ROOT/$system" -type f -print0)
    fi
  done

  progress_start "$total_work" "동기화를 준비하고 있습니다…"

  local esde_stopped=0 esde_restarted=0

  if [[ "$MANAGE_ESDE" == "1" && "$SYNC_GAMELISTS" == "1" ]]; then
    progress_update "$PROGRESS_VALUE" "Pocket Classic의 ES-DE를 잠시 종료하고 있습니다…"
    if stop_esde "$serial" "$ESDE_PACKAGE"; then esde_stopped=1
    elif ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; printf 'ADB DISCONNECTED while stopping ES-DE\n' >>"$LOG_FILE"; fi
    progress_step "ES-DE 종료 완료"
  else
    progress_step "ES-DE 자동 관리를 건너뜁니다."
  fi

  for system in $SYSTEMS; do
    [[ "${ADB_DISCONNECTED:-0}" == "0" ]] || break
    [[ "$rom_abort" == 0 ]] || break
    local system_sync_ok=1
    local_rom_index="$TMP_DIR/local-rom-${safe_serial}-${system}.nul"
    : > "$local_rom_index"
    local local_rom_dir="$LOCAL_ROM_ROOT/$system"
    if [[ -L "$local_rom_dir" || ! -d "$local_rom_dir" || ! -r "$local_rom_dir" || ! -x "$local_rom_dir" ]]; then
      ((rom_failed++))
      rom_recovery_reports+=("로컬 ROM 원본 경로가 없거나 디렉터리가 아니거나 읽을 수 없습니다: $local_rom_dir; 시스템 ROM/gamelist/media 변경 중단")
      printf '%s\n' "${rom_recovery_reports[@]}" >>"$LOG_FILE"
      rm -f "$local_rom_index"
      continue
    fi
    if ! find "$local_rom_dir" -type f -print0 >"$local_rom_index" 2>>"$LOG_FILE"; then
      ((rom_failed++))
      rom_recovery_reports+=("로컬 ROM 목록 조회 실패: $local_rom_dir; 시스템 ROM/gamelist/media 변경 중단")
      printf '%s\n' "${rom_recovery_reports[@]}" >>"$LOG_FILE"
      rm -f "$local_rom_index"
      continue
    fi
    rom_index_file="$TMP_DIR/remote-rom-${safe_serial}-${system}.idx"
    rom_index_ok=1
    if ! build_remote_index "$serial" "$system" "$REMOTE_ROM_ROOT" "$rom_index_file"; then
      rom_index_ok=0
      system_sync_ok=0
      ((rom_failed++))
      printf 'SYSTEM SYNC BLOCKED: %s; ROM index is incomplete or invalid\n' "$system" >>"$LOG_FILE"
      if ! adb_connection_alive "$serial"; then
        ADB_DISCONNECTED=1
        printf 'ADB DISCONNECTED after ROM index failure: %s\n' "$system" >>"$LOG_FILE"
      fi
    fi

    if [[ "$rom_index_ok" == 1 ]]; then
      local pending_report
      if ! pending_report="$(rom_pending_transactions "$serial" "$REMOTE_ROM_ROOT/$system")"; then
        system_sync_ok=0; rom_abort=1; ((rom_failed++))
        rom_recovery_reports+=("ROM 미완료 트랜잭션 또는 조회 오류: $REMOTE_ROM_ROOT/$system | $pending_report; 자동 변경 중단, 복구 파일 보존")
        printf '%s\n' "${rom_recovery_reports[@]}" >>"$LOG_FILE"
        if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; fi
      fi
    fi

    declare -A REMOTE_ROM_SIZE=()
    declare -A LOCAL_ROM_PRESENT=()

    if [[ "$rom_index_ok" == "1" ]]; then
      while IFS= read -r -d '' rel && IFS= read -r -d '' rsize; do
        REMOTE_ROM_SIZE["$rel"]="$rsize"
      done < "$rom_index_file"
    fi

    if [[ "$rom_index_ok" == "1" && "$system_sync_ok" == 1 && -d "$LOCAL_ROM_ROOT/$system" ]]; then
      while IFS= read -r -d '' file; do
        if ! is_rom_file "$file"; then ((ignored++)); continue; fi

        rel="${file#"$LOCAL_ROM_ROOT"/}"
        LOCAL_ROM_PRESENT["$rel"]=1
        progress_update "$PROGRESS_VALUE" "ROM 검사: $rel"

        rsize="${REMOTE_ROM_SIZE[$rel]:-}"
        if rom_compare "$serial" "$file" "$REMOTE_ROM_ROOT/$rel" "$rsize"; then
          ((rom_same++))
          progress_step "ROM 동일: $rel"
          continue
        else
          local compare_status=$?
          if [[ "$compare_status" -eq 2 ]]; then
            ((rom_failed++))
            printf 'ROM HASH VERIFICATION FAILED: %s\n' "$rel" >>"$LOG_FILE"
            progress_step "ROM 해시 검증 실패: $rel"
            if [[ "${ROM_RECOVERY_REQUIRED:-0}" == 1 ]]; then
              rom_recovery_reports+=("$ROM_RECOVERY_REPORT")
              system_sync_ok=0; rom_abort=1
              break
            fi
            if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; printf 'ADB DISCONNECTED during ROM hash: %s\n' "$rel" >>"$LOG_FILE"; break; fi
            continue
          fi
        fi

        if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; ((rom_failed++)); printf 'ADB DISCONNECTED before ROM update: %s\n' "$rel" >>"$LOG_FILE"; break; fi
        if push_rom_verified "$serial" "$file" "$REMOTE_ROM_ROOT/$rel" "$ROM_LOCAL_SIZE" "$ROM_LOCAL_HASH"; then
          ((rom_copied++))
          rom_copied_files+=("✓ $rel")
          printf 'ROM SYNCED: %s\n' "$rel" >>"$LOG_FILE"
        else
          ((rom_failed++))
          system_sync_ok=0
          rom_recovery_reports+=("${ROM_RECOVERY_REPORT:-ROM 교체 실패: $rel}")
          [[ "${ROM_RECOVERY_REQUIRED:-0}" == 1 ]] && rom_abort=1
          if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; printf 'ADB DISCONNECTED during ROM update: %s\n' "$rel" >>"$LOG_FILE"; break; fi
          break
        fi
        progress_step "ROM 처리 완료: $rel"
      done < "$local_rom_index"
    fi

    if [[ "$rom_index_ok" == "1" && "$system_sync_ok" == 1 && "$MIRROR_ROMS" == "1" && "$ADB_DISCONNECTED" != "1" ]]; then
      for rel in "${!REMOTE_ROM_SIZE[@]}"; do
        [[ "$rel" == "$system/"* ]] || continue
        if [[ -z "${LOCAL_ROM_PRESENT[$rel]:-}" ]] && is_rom_file "$rel"; then
          rom_artifact_paths "$REMOTE_ROM_ROOT/$rel"
          ROM_OLD_SIZE=unknown; ROM_OLD_HASH=unknown
          local delete_state
          delete_state="$(rom_remote_probe "$serial")" || delete_state=ERROR
          if [[ "$delete_state" == BUSY || "$delete_state" == ERROR ]]; then
            ((rom_failed++)); system_sync_ok=0; rom_abort=1
            rom_failure "$serial" PENDING 'ROM 삭제 전 미완료 트랜잭션/상태 오류; 삭제 차단' 1 || true
            rom_recovery_reports+=("$ROM_RECOVERY_REPORT")
            break
          fi
          if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; ((rom_failed++)); printf 'ADB DISCONNECTED before ROM delete: %s\n' "$rel" >>"$LOG_FILE"; break; fi
          if delete_remote_file "$serial" "$REMOTE_ROM_ROOT/$rel"; then
            ((rom_deleted++))
            rom_deleted_files+=("✗ $rel")
            printf 'ROM DELETED: %s\n' "$rel" >>"$LOG_FILE"
          else
            ((rom_failed++))
            if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; printf 'ADB DISCONNECTED during ROM delete: %s\n' "$rel" >>"$LOG_FILE"; break; fi
          fi
        fi
      done
    fi

    unset REMOTE_ROM_SIZE LOCAL_ROM_PRESENT
    rm -f "$rom_index_file" "$local_rom_index"

    if [[ "$system_sync_ok" == "1" && "$ADB_DISCONNECTED" != "1" && "$SYNC_GAMELISTS" == "1" ]]; then
      local_gl="$LOCAL_GAMELIST_ROOT/$system/gamelist.xml"
      remote_gl="$REMOTE_GAMELIST_ROOT/$system/gamelist.xml"
      if [[ -f "$local_gl" ]]; then
        progress_update "$PROGRESS_VALUE" "gamelist 변환/비교: $system"

        case "$system" in
          gb) mapping="$ALTEMU_MAP_GB" ;;
          gbc) mapping="$ALTEMU_MAP_GBC" ;;
          *) mapping="" ;;
        esac

        temp_gl="$TMP_DIR/gamelist-${safe_serial}-${system}.xml"
        count_file="$TMP_DIR/gamelist-${safe_serial}-${system}.count"
        rm -f "$count_file"

        removed_file="$TMP_DIR/gamelist-${safe_serial}-${system}.removed"
        remote_temp_gl="$TMP_DIR/gamelist-remote-${safe_serial}-${system}.xml"
        local merge_remote=""
        local master_temp_gl="$TMP_DIR/gamelist-master-${safe_serial}-${system}.xml"
        # Snapshot Legion first; only this Android-bound working copy is merged.
        if cp "$local_gl" "$master_temp_gl" && read_remote_gamelist "$serial" "$remote_gl" "$remote_temp_gl"; then
          [[ -f "$remote_temp_gl" ]] && merge_remote="$remote_temp_gl"
          if transform_gamelist "$master_temp_gl" "$temp_gl" "$mapping" "$count_file" "$system" "$removed_file" "$merge_remote" "$runtime_map_file" "$serial"; then
            changed="$(cat "$count_file" 2>/dev/null || printf '0')"
            removed="$(cat "$removed_file" 2>/dev/null || printf '0')"
            [[ "$changed" =~ ^[0-9]+$ ]] || changed=0
            [[ "$removed" =~ ^[0-9]+$ ]] || removed=0
            gl_transformed=$((gl_transformed + changed))
            gl_alt_removed=$((gl_alt_removed + removed))

            alt_list_file="$TMP_DIR/altemulator-list-${safe_serial}-${system}.txt"
            list_altemulator_games "$local_gl" "$system" "$alt_list_file"
            if [[ -s "$alt_list_file" ]]; then
              while IFS= read -r alt_line; do
                altemulator_games+=("$alt_line")
              done < "$alt_list_file"
            fi
            rm -f "$alt_list_file"

            if [[ -s "$remote_temp_gl" ]] && xml_semantic_equal "$temp_gl" "$remote_temp_gl"; then
              ((gl_same++))
              printf 'GAMELIST SAME (semantic): %s/gamelist.xml\n' "$system" >>"$LOG_FILE"
            else
              if [[ -s "$remote_temp_gl" ]]; then
                diff_file="$TMP_DIR/gamelist-diff-${safe_serial}-${system}.txt"
                xml_semantic_diff "$temp_gl" "$remote_temp_gl" "$system" "$diff_file"
                if [[ -s "$diff_file" ]]; then
                  while IFS= read -r diff_line; do
                    gamelist_diff_reports+=("$diff_line")
                    printf 'GAMELIST DIFF: %s\n' "$diff_line" >>"$LOG_FILE"
                  done < "$diff_file"
                fi
                rm -f "$diff_file"
              fi

              if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; ((gl_failed++)); printf 'ADB DISCONNECTED before gamelist update: %s\n' "$system" >>"$LOG_FILE"
              elif push_file "$serial" "$temp_gl" "$remote_gl"; then
                ((gl_copied++))
                gamelist_copied_files+=("✓ $system/gamelist.xml")
                printf 'GAMELIST SYNCED: %s/gamelist.xml\n' "$system" >>"$LOG_FILE"
              else
                ((gl_failed++))
                if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; printf 'ADB DISCONNECTED during gamelist update: %s\n' "$system" >>"$LOG_FILE"; fi
              fi
            fi
          else
            ((gl_failed++))
            printf 'GAMELIST MERGE/TRANSFORM FAILED: %s/gamelist.xml\n' "$system" >>"$LOG_FILE"
          fi
        else
          ((gl_failed++))
        fi

        if (( gl_failed > 0 )) && ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; fi

        rm -f "$temp_gl" "$count_file" "$removed_file" "$remote_temp_gl" "$master_temp_gl"
        progress_step "gamelist 처리 완료: $system"
      fi
    fi

    if [[ "$system_sync_ok" == "1" && "$ADB_DISCONNECTED" != "1" && "$SYNC_MEDIA" == "1" ]]; then
      media_dir="$LOCAL_MEDIA_ROOT/$system"
      if [[ -d "$media_dir" ]]; then
        progress_update "$PROGRESS_VALUE" "미디어 목록을 한 번에 불러오는 중: $system"
        index_file="$TMP_DIR/remote-media-${safe_serial}-${system}.idx"
        media_index_ok=1
        local_media_index="$TMP_DIR/local-media-${safe_serial}-${system}.nul"
        if ! find "$media_dir" -type f -print0 >"$local_media_index" 2>>"$LOG_FILE"; then
          media_index_ok=0
          ((media_failed++))
          printf 'LOCAL MEDIA INDEX FAILED: %s; transfers/deletions blocked\n' "$system" >>"$LOG_FILE"
        elif ! build_remote_index "$serial" "$system" "$REMOTE_MEDIA_ROOT" "$index_file"; then
          media_index_ok=0
          ((media_failed++))
          printf 'MEDIA INDEX FAILED: %s; deletions blocked\n' "$system" >>"$LOG_FILE"
          if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; printf 'ADB DISCONNECTED after media index failure: %s\n' "$system" >>"$LOG_FILE"; fi
        fi

        declare -A REMOTE_MEDIA_SIZE=()
        declare -A LOCAL_MEDIA_PRESENT=()
        if [[ "$media_index_ok" == "1" ]]; then
          while IFS= read -r -d '' rel && IFS= read -r -d '' rsize; do
            REMOTE_MEDIA_SIZE["$rel"]="$rsize"
          done < "$index_file"
        fi

        while IFS= read -r -d '' file; do
          [[ "$media_index_ok" == "1" ]] || break
          ((media_seen++))
          rel="${file#"$LOCAL_MEDIA_ROOT"/}"
          LOCAL_MEDIA_PRESENT["$rel"]=1
          progress_update "$PROGRESS_VALUE" "미디어 검사 ${media_seen}/${media_total}: $rel"

          local lsize
          lsize="$(stat -c '%s' "$file")"
          rsize="${REMOTE_MEDIA_SIZE[$rel]:-}"

          if [[ -n "$rsize" && "$rsize" == "$lsize" ]]; then
            ((media_same++))
          elif ! adb_connection_alive "$serial"; then
            ADB_DISCONNECTED=1; ((media_failed++)); printf 'ADB DISCONNECTED before media update: %s\n' "$rel" >>"$LOG_FILE"; break
          elif push_file "$serial" "$file" "$REMOTE_MEDIA_ROOT/$rel"; then
            ((media_copied++))
            media_copied_files+=("✓ $rel")
            printf 'MEDIA SYNCED: %s\n' "$rel" >>"$LOG_FILE"
          else
            ((media_failed++))
            if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; printf 'ADB DISCONNECTED during media update: %s\n' "$rel" >>"$LOG_FILE"; break; fi
          fi

          progress_step "미디어 ${media_seen}/${media_total} 처리 완료"
        done < "$local_media_index"

        # Legion Go S에 없는 원격 미디어 삭제
        if [[ "$media_index_ok" == "1" && "$MIRROR_MEDIA" == "1" && "$ADB_DISCONNECTED" != "1" ]]; then
          for rel in "${!REMOTE_MEDIA_SIZE[@]}"; do
            [[ "$rel" == "$system/"* ]] || continue
            if [[ -z "${LOCAL_MEDIA_PRESENT[$rel]:-}" ]]; then
              if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; ((media_failed++)); printf 'ADB DISCONNECTED before media delete: %s\n' "$rel" >>"$LOG_FILE"; break; fi
              if delete_remote_file "$serial" "$REMOTE_MEDIA_ROOT/$rel"; then
                ((media_deleted++))
                media_deleted_files+=("✗ $rel")
                printf 'MEDIA DELETED: %s\n' "$rel" >>"$LOG_FILE"
              else
                ((media_failed++))
                printf 'MEDIA DELETE FAILED: %s\n' "$rel" >>"$LOG_FILE"
                if ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; break; fi
              fi
            fi
          done
        fi

        unset REMOTE_MEDIA_SIZE LOCAL_MEDIA_PRESENT
        rm -f "$index_file" "$local_media_index"
      fi
    fi
    [[ "$ADB_DISCONNECTED" == "1" ]] && break
    [[ "$rom_abort" == 1 ]] && break
  done

  if [[ "$MANAGE_ESDE" == "1" && "$esde_stopped" -eq 1 ]]; then
    progress_update "$PROGRESS_VALUE" "Pocket Classic의 ES-DE를 다시 실행하고 있습니다…"
    if [[ "$rom_abort" == 0 && "$ADB_DISCONNECTED" != "1" ]] && adb_connection_alive "$serial" && start_esde "$serial" "$ESDE_ACTIVITY"; then esde_restarted=1
    elif ! adb_connection_alive "$serial"; then ADB_DISCONNECTED=1; printf 'ADB DISCONNECTED before restarting ES-DE\n' >>"$LOG_FILE"; fi
    progress_step "ES-DE 재실행 완료"
  else
    progress_step "ES-DE 재실행을 건너뜁니다."
  fi

  progress_close

  local total_failed=$((rom_failed + gl_failed + media_failed))
  local esde_status="자동 관리 안 함"
  if [[ "$MANAGE_ESDE" == "1" ]]; then
    if [[ "$esde_stopped" -eq 1 && "$esde_restarted" -eq 1 ]]; then esde_status="종료 후 재실행 완료"
    elif [[ "$esde_stopped" -eq 1 ]]; then esde_status="종료됨 / 재실행 실패"
    else esde_status="종료 실패"
    fi
  fi

  local details=""
  details+="$(append_changes "[ROM 전송]" 20 "${rom_copied_files[@]}")"
  details+="$(append_changes "[ROM 삭제]" 20 "${rom_deleted_files[@]}")"
  details+="$(append_changes "[gamelist 전송]" 20 "${gamelist_copied_files[@]}")"
  details+="$(append_changes "[gamelist 실제 차이]" 30 "${gamelist_diff_reports[@]}")"
  details+="$(append_changes "[Legion Go S altemulator 지정 게임]" 50 "${altemulator_games[@]}")"
  details+="$(append_changes "[미디어 전송]" 20 "${media_copied_files[@]}")"
  details+="$(append_changes "[미디어 삭제]" 20 "${media_deleted_files[@]}")"
  details+="$(append_changes "[ROM 교체 및 복구 상태]" 100 "${rom_recovery_reports[@]}")"

  local summary="기기: $manufacturer $model
동기화 시스템: $SYSTEMS
ES-DE: $esde_status

[ROM 미러링]
전송/갱신: ${rom_copied}개
동일 파일: ${rom_same}개
원격 삭제: ${rom_deleted}개
비-ROM 제외: ${ignored}개

[gamelists]
전송/갱신: ${gl_copied}개
동일 파일: ${gl_same}개
altemulator 변환: ${gl_transformed}개
비-Standalone 제거: ${gl_alt_removed}개

[downloaded_media 미러링]
전송/갱신: ${media_copied}개
동일 파일: ${media_same}개
원격 삭제: ${media_deleted}개

실패: ${total_failed}개${details}

※ ROM은 Legion Go S 기준으로 미러링합니다.
※ 변경 파일 목록은 항목별 최대 20개까지 표시합니다.
※ 세이브/상태/메타데이터 파일은 삭제하지 않습니다.
※ downloaded_media도 Legion Go S 기준으로 미러링합니다.
※ arcade의 altemulator는 그대로 유지합니다.
※ 그 외 시스템은 (Standalone)만 유지/변환하고 비-Standalone altemulator는 Android용 사본에서 제거합니다.
※ gamelist.xml 자체는 변환 후 동기화하며 별도 삭제 대상이 아닙니다."

  if ((total_failed == 0)) && [[ "$esde_restarted" -eq 1 || "$MANAGE_ESDE" != "1" ]]; then
    notify "$APP_NAME 완료" "$summary"
  else
    error "$summary"
  fi
}

if [[ "${ESDE_SYNC_LIBRARY_ONLY:-0}" != "1" ]]; then
  trap 'progress_close' EXIT
  main "$@"
fi
