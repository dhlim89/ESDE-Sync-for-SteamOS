#!/usr/bin/env bash
set -u

APP_NAME="ES-DE Sync"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/esde-sync"
PROFILE_DIR="$CONFIG_DIR/profiles"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/esde-sync"
TMP_DIR="${TMPDIR:-/tmp}/esde-sync"
LOG_FILE="$STATE_DIR/esde-sync.log"
GUI_MODE="${ESDE_SYNC_GUI_MODE:-0}"
GUI_STATUS_FILE="${ESDE_SYNC_STATUS_FILE:-$STATE_DIR/gui-status.tsv}"
GUI_RESULT_FILE="${ESDE_SYNC_RESULT_FILE:-$STATE_DIR/gui-result.txt}"

mkdir -p "$PROFILE_DIR" "$STATE_DIR" "$TMP_DIR"

gui_status() {
  local value="$1" max="$2" label="$3"
  [[ "$GUI_MODE" == "1" ]] || return 0
  printf '%s\t%s\t%s\n' "$value" "$max" "$label" > "$GUI_STATUS_FILE"
}


ROM_EXTENSIONS=(gb gbc gba zip 7z nes fds smc sfc md gen bin gg sms pce cue chd iso cso pbp n64 z64 v64 nds)

ESDE_PACKAGE_DEFAULT="org.es_de.frontend"
ESDE_ACTIVITY_DEFAULT="org.es_de.frontend/.MainActivityHomeApp"

PROGRESS_REF=""
QDBUS_CMD=""
PROGRESS_VALUE=0
PROGRESS_MAX=1

notify() {
  local title="$1" text="$2"
  if [[ "$GUI_MODE" == "1" ]]; then
    printf 'OK
%s
' "$text" > "$GUI_RESULT_FILE"
    gui_status "$PROGRESS_MAX" "$PROGRESS_MAX" "완료"
    return 0
  fi
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "$title" --msgbox "$text" >/dev/null 2>&1 || true
  else
    printf '
%s
%s
' "$title" "$text"
  fi
}

error() {
  local text="$1"
  progress_close
  if [[ "$GUI_MODE" == "1" ]]; then
    printf 'ERROR
%s
' "$text" > "$GUI_RESULT_FILE"
    gui_status "$PROGRESS_VALUE" "$PROGRESS_MAX" "오류"
    return 0
  fi
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "$APP_NAME" --error "$text" >/dev/null 2>&1 || true
  else
    printf 'ERROR: %s
' "$text" >&2
  fi
}

detect_qdbus() {
  if command -v qdbus6 >/dev/null 2>&1; then QDBUS_CMD="qdbus6"
  elif command -v qdbus >/dev/null 2>&1; then QDBUS_CMD="qdbus"
  elif command -v qdbus-qt5 >/dev/null 2>&1; then QDBUS_CMD="qdbus-qt5"
  else QDBUS_CMD=""
  fi
}

progress_start() {
  local max="$1" label="$2"
  PROGRESS_MAX="$max"; PROGRESS_VALUE=0
  gui_status 0 "$max" "$label"
  detect_qdbus
  if [[ "$GUI_MODE" != "1" ]] && command -v kdialog >/dev/null 2>&1 && [[ -n "$QDBUS_CMD" ]]; then
    PROGRESS_REF="$(kdialog --title "$APP_NAME" --progressbar "$label" "$max" 2>/dev/null || true)"
    if [[ -n "$PROGRESS_REF" ]]; then
      $QDBUS_CMD $PROGRESS_REF setAutoClose false >/dev/null 2>&1 || true
      $QDBUS_CMD $PROGRESS_REF showCancelButton false >/dev/null 2>&1 || true
    fi
  fi
}

progress_update() {
  local value="$1" label="$2"
  PROGRESS_VALUE="$value"
  gui_status "$value" "$PROGRESS_MAX" "$label"
  if [[ -n "$PROGRESS_REF" && -n "$QDBUS_CMD" ]]; then
    $QDBUS_CMD $PROGRESS_REF Set "" value "$value" >/dev/null 2>&1 || true
    $QDBUS_CMD $PROGRESS_REF setLabelText "$label" >/dev/null 2>&1 || true
  fi
}

progress_step() {
  local label="$1"
  PROGRESS_VALUE=$((PROGRESS_VALUE + 1))
  ((PROGRESS_VALUE > PROGRESS_MAX)) && PROGRESS_VALUE="$PROGRESS_MAX"
  progress_update "$PROGRESS_VALUE" "$label"
}

progress_close() {
  if [[ -n "$PROGRESS_REF" && -n "$QDBUS_CMD" ]]; then
    $QDBUS_CMD $PROGRESS_REF close >/dev/null 2>&1 || true
  fi
  PROGRESS_REF=""
  [[ "$GUI_MODE" == "1" ]] && return 0
}

sanitize() { printf '%s' "$1" | tr -cs '[:alnum:]_.-' '_'; }
adb_device_count() { adb devices </dev/null | awk 'NR>1 && $2=="device"{c++} END{print c+0}'; }
first_device_serial() { adb devices </dev/null | awk 'NR>1 && $2=="device"{print $1; exit}'; }
get_prop() { adb -s "$1" shell getprop "$2" </dev/null 2>/dev/null | tr -d '\r'; }

is_rom_file() {
  local file="$1" name ext allowed
  name="${file##*/}"; [[ "$name" == *.* ]] || return 1
  ext="${name##*.}"; ext="${ext,,}"
  for allowed in "${ROM_EXTENSIONS[@]}"; do
    [[ "$ext" == "$allowed" ]] && return 0
  done
  return 1
}

remote_size() {
  local serial="$1" remote="$2"
  local escaped="${remote//\'/\'\\\'\'}"
  adb -s "$serial" shell "stat -c %s '$escaped' 2>/dev/null" </dev/null | tr -d '\r'
}

remote_shell_quote() {
  local value="$1"
  value="${value//\'/\'\\\'\'}"
  printf "'%s'" "$value"
}

remote_sha256_device() {
  local serial="$1" remote="$2" expected_size="${3:-}"
  local quoted response marker status before digest after
  quoted="$(remote_shell_quote "$remote")"
  # The framed response is authoritative; adb's status may not preserve the
  # remote shell status. Validate size both before and after hashing.
  response="$(adb -s "$serial" exec-out "
    p=$quoted
    before=\$(stat -c %s \"\$p\" 2>/dev/null) || { printf 'ESDE_HASH_V1 ERROR\\n'; exit 0; }
    case \"\$before\" in ''|*[!0-9]*) printf 'ESDE_HASH_V1 ERROR\\n'; exit 0;; esac
    if command -v sha256sum >/dev/null 2>&1; then h=\$(sha256sum \"\$p\" 2>/dev/null); rc=\$?
    elif command -v toybox >/dev/null 2>&1; then h=\$(toybox sha256sum \"\$p\" 2>/dev/null); rc=\$?
    else printf 'ESDE_HASH_V1 UNSUPPORTED\\n'; exit 0; fi
    [ \"\$rc\" -eq 0 ] || { printf 'ESDE_HASH_V1 ERROR\\n'; exit 0; }
    digest=\${h%% *}
    case \"\$digest\" in ''|*[!0-9a-fA-F]*) printf 'ESDE_HASH_V1 ERROR\\n'; exit 0;; esac
    [ \"\${#digest}\" -eq 64 ] || { printf 'ESDE_HASH_V1 ERROR\\n'; exit 0; }
    after=\$(stat -c %s \"\$p\" 2>/dev/null) || { printf 'ESDE_HASH_V1 ERROR\\n'; exit 0; }
    [ \"\$before\" = \"\$after\" ] || { printf 'ESDE_HASH_V1 ERROR\\n'; exit 0; }
    printf 'ESDE_HASH_V1 FILE %s %s %s\\n' \"\$before\" \"\$digest\" \"\$after\"
  " </dev/null 2>>"$LOG_FILE" | tr -d '\r')" || return 1
  read -r marker status before digest after extra <<< "$response"
  [[ "$response" != *$'\n'* && "$marker" == ESDE_HASH_V1 && "$status" == FILE && -z "${extra:-}" ]] || return 1
  [[ "$before" =~ ^[0-9]+$ && "$before" == "$after" ]] || return 1
  [[ -z "$expected_size" || "$before" == "$expected_size" ]] || return 1
  [[ "$digest" =~ ^[[:xdigit:]]{64}$ ]] || return 1
  printf '%s\n' "${digest,,}"
}

remote_sha256_stream() {
  local serial="$1" remote="$2" expected_size="${3:-}" before after actual digest tmp quoted
  tmp="$TMP_DIR/remote-rom-${BASHPID}-${RANDOM}.bin"
  before="$(remote_size "$serial" "$remote")"
  [[ "$before" =~ ^[0-9]+$ ]] || return 1
  [[ -z "$expected_size" || "$before" == "$expected_size" ]] || return 1
  quoted="$(remote_shell_quote "$remote")"
  # Fallback for Android builds without a usable sha256sum applet. Stream to
  # disk, then require exact byte count and stable remote size around the read.
  adb -s "$serial" exec-out "cat $quoted 2>/dev/null" </dev/null >"$tmp" 2>>"$LOG_FILE" || true
  actual="$(stat -c '%s' "$tmp" 2>/dev/null)"
  after="$(remote_size "$serial" "$remote")"
  if [[ ! "$actual" =~ ^[0-9]+$ || "$before" != "$after" || "$actual" != "$before" ]]; then
    rm -f "$tmp"
    return 1
  fi
  digest="$(local_sha256 "$tmp")" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  printf '%s\n' "$digest"
}

remote_sha256() {
  local serial="$1" remote="$2" expected_size="${3:-}" digest
  digest="$(remote_sha256_device "$serial" "$remote" "$expected_size")" && {
    printf '%s\n' "$digest"
    return 0
  }
  remote_sha256_stream "$serial" "$remote" "$expected_size"
}

local_sha256() {
  local file="$1" output before after
  before="$(stat -c '%s:%y:%i' -- "$file")" || return 1
  output="$(sha256sum -- "$file")" || return 1
  output="${output%% *}"
  [[ "$output" =~ ^[[:xdigit:]]{64}$ ]] || return 1
  after="$(stat -c '%s:%y:%i' -- "$file")" || return 1
  [[ "$before" == "$after" ]] || return 1
  printf '%s\n' "${output,,}"
}

# Stable names make interrupted work visible on the next run. No artifact ends
# in a ROM extension. Only the process that exclusively claims the txn may clean it.
rom_artifact_paths() {
  local remote="$1" key
  [[ "$remote" == /* && -n "${remote##*/}" && "${remote##*/}" != . && "${remote##*/}" != .. ]] || return 1
  key="$(printf '%s' "$remote" | sha256sum)" || return 1
  key="${key%% *}"
  [[ "$key" =~ ^[0-9a-f]{64}$ ]] || return 1
  ROM_FINAL="$remote"
  ROM_DIR="${remote%/*}"
  ROM_TXN="$ROM_DIR/.esde-sync-$key.txn"
  ROM_BACKUP="$ROM_DIR/.esde-sync-$key.backup"
  ROM_PART="$ROM_DIR/.esde-sync-$key.part"
  ROM_RESTORE="$ROM_DIR/.esde-sync-$key.restore"
  ROM_LEGACY_PREFIX="$ROM_DIR/.${remote##*/}.esde-sync-part-"
}

# All operations carry an exact stdout status. An adb/remote exit code alone is
# never evidence that an operation succeeded. The heredocs avoid nested host
# double-quote expansion of Android shell source.
rom_remote_header() {
  printf 'p=%s\ndir=%s\ntxn=%s\nbackup=%s\npart=%s\nrestore=%s\nlegacy=%s\n' \
    "$(remote_shell_quote "$ROM_FINAL")" "$(remote_shell_quote "$ROM_DIR")" \
    "$(remote_shell_quote "$ROM_TXN")" "$(remote_shell_quote "$ROM_BACKUP")" \
    "$(remote_shell_quote "$ROM_PART")" "$(remote_shell_quote "$ROM_RESTORE")" \
    "$(remote_shell_quote "$ROM_LEGACY_PREFIX")"
}

rom_remote_probe() {
  local serial="$1" check_pending="${2:-1}" script response
  script="$(rom_remote_header)
check_pending=$check_pending
$(cat <<'SH'
if [ "$check_pending" = 1 ]; then
  for f in "$txn" "$backup" "$part" "$restore" "$legacy"*; do
    if [ -e "$f" ] || [ -L "$f" ]; then printf 'ESDE_ROM_STATE_V1 BUSY\n'; exit 0; fi
  done
fi
if [ -L "$p" ]; then printf 'ESDE_ROM_STATE_V1 ERROR\n'; exit 0; fi
if [ -e "$p" ]; then
  if [ ! -f "$p" ]; then printf 'ESDE_ROM_STATE_V1 ERROR\n'; exit 0; fi
  n=$(stat -c %s "$p" 2>/dev/null)
  case "$n" in ''|*[!0-9]*) printf 'ESDE_ROM_STATE_V1 ERROR\n'; exit 0;; esac
  printf 'ESDE_ROM_STATE_V1 FILE %s\n' "$n"
else
  ancestor="$dir"
  while [ ! -e "$ancestor" ]; do
    if [ -L "$ancestor" ] || [ "$ancestor" = / ]; then printf 'ESDE_ROM_STATE_V1 ERROR\n'; exit 0; fi
    ancestor=${ancestor%/*}
    if [ -z "$ancestor" ]; then ancestor=/; fi
  done
  if [ ! -d "$ancestor" ] || [ ! -r "$ancestor" ] || [ ! -x "$ancestor" ]; then printf 'ESDE_ROM_STATE_V1 ERROR\n'; exit 0; fi
  printf 'ESDE_ROM_STATE_V1 MISSING\n'
fi
SH
)"
  response="$(adb -s "$serial" exec-out "$script" </dev/null 2>>"$LOG_FILE")" || return 1
  case "$response" in
    'ESDE_ROM_STATE_V1 MISSING') printf 'MISSING\n' ;;
    'ESDE_ROM_STATE_V1 BUSY') printf 'BUSY\n' ;;
    *) if [[ "$response" =~ ^ESDE_ROM_STATE_V1\ FILE\ ([0-9]+)$ ]]; then
         printf 'FILE %s\n' "${BASH_REMATCH[1]}"
       else return 1; fi ;;
  esac
}

rom_remote_space() {
  local serial="$1" script
  script="$(rom_remote_header)
$(cat <<'SH'
ancestor="$dir"
while [ ! -e "$ancestor" ]; do
  if [ -L "$ancestor" ] || [ "$ancestor" = / ]; then printf 'ESDE_ROM_SPACE_V1 ERROR\n'; exit 0; fi
  ancestor=${ancestor%/*}
  if [ -z "$ancestor" ]; then ancestor=/; fi
 done
space=$(stat -f -c '%a %S' "$ancestor" 2>/dev/null)
set -- $space
if [ "$#" != 2 ]; then printf 'ESDE_ROM_SPACE_V1 ERROR\n'; exit 0; fi
case "$1:$2" in *[!0-9:]*|:*|*:) printf 'ESDE_ROM_SPACE_V1 ERROR\n'; exit 0;; esac
printf 'ESDE_ROM_SPACE_V1 %s %s\n' "$1" "$2"
SH
)"
  adb -s "$serial" exec-out "$script" </dev/null 2>>"$LOG_FILE"
}

rom_remote_action() {
  local serial="$1" action="$2" script response meta
  case "$action" in CLAIM|BACKUP|RESTORE_COPY|REPLACE|RESTORE|CLEAN) ;; *) return 1;; esac
  meta="ESDE_ROM_RECOVERY_V1 $ROM_OLD_SIZE $ROM_OLD_HASH $ROM_NEW_SIZE $ROM_NEW_HASH"
  script="$(rom_remote_header)
action=$action
meta=$(remote_shell_quote "$meta")
$(cat <<'SH'
rc=1
case "$action" in
  CLAIM)
    if mkdir -p "$dir" 2>/dev/null; then
      if mkdir "$txn" 2>/dev/null; then
        # Never overwrite any prior backup/part, including an orphan without txn.
        if [ ! -e "$backup" ] && [ ! -L "$backup" ] && [ ! -e "$part" ] && [ ! -L "$part" ] && [ ! -e "$restore" ] && [ ! -L "$restore" ]; then
          if printf '%s\n' "$meta" > "$txn/old.meta" && printf '%s' "$p" > "$txn/target.path"; then rc=0; fi
        fi
      fi
    fi ;;
  BACKUP)
    set -C
    if cat "$p" > "$backup"; then rc=0; fi ;;
  RESTORE_COPY)
    set -C
    if cat "$backup" > "$restore"; then rc=0; fi ;;
  REPLACE)
    if mv -f "$part" "$p"; then rc=0; fi ;;
  RESTORE)
    if mv -f "$restore" "$p"; then rc=0; fi ;;
  CLEAN)
    if rm -f "$backup" "$part" "$restore"; then
      if rm -f "$txn/old.meta" "$txn/target.path"; then
        if rmdir "$txn"; then rc=0; fi
      fi
    fi ;;
esac
if [ "$rc" = 0 ]; then printf 'ESDE_ROM_OP_V1 %s OK\n' "$action"; else printf 'ESDE_ROM_OP_V1 %s ERROR\n' "$action"; fi
SH
)"
  adb_connection_alive "$serial" || return 1
  response="$(adb -s "$serial" exec-out "$script" </dev/null 2>>"$LOG_FILE")" || return 1
  [[ "$response" == "ESDE_ROM_OP_V1 $action OK" ]]
}

rom_verify_bytes() {
  local digest
  digest="$(remote_sha256 "$1" "$2" "$3")" || return 1
  [[ "$digest" == "$4" ]]
}

rom_failure() {
  local serial="$1" status="$2" reason="$3" retain="${4:-0}"
  if ! adb_connection_alive "$serial"; then
    status=UNKNOWN
    retain=1
    ADB_DISCONNECTED=1
  fi
  ROM_REPLACE_STATUS="$status"
  ROM_RECOVERY_REQUIRED="$retain"
  ROM_RECOVERY_REPORT="ROM 상태: $status | $ROM_FINAL | $reason"
  if [[ "$retain" == 1 ]]; then
    ROM_RECOVERY_REPORT+=$'\n'"수동 확인: backup=$ROM_BACKUP | part=$ROM_PART | restore=$ROM_RESTORE | metadata=$ROM_TXN/old.meta | target=$ROM_TXN/target.path"
    ROM_RECOVERY_REPORT+=$'\n'"기존 ROM 검증값: size=${ROM_OLD_SIZE:-unknown} sha256=${ROM_OLD_HASH:-unknown}; 기존 파일과 복구 파일을 삭제하지 마세요."
  fi
  printf '%s\n' "$ROM_RECOVERY_REPORT" >>"$LOG_FILE"
  return 1
}

# Backup is copied, never moved. A failed restore may destroy the destination,
# but cannot consume the verified backup. Artifacts remain after every failure.
rom_restore_backup() {
  local serial="$1"
  if ! adb_connection_alive "$serial"; then rom_failure "$serial" UNKNOWN '교체 결과 불명; 연결 단절로 복원하지 못함' 1; return 1; fi
  if rom_verify_bytes "$serial" "$ROM_FINAL" "$ROM_OLD_SIZE" "$ROM_OLD_HASH"; then
    rom_failure "$serial" FAILED_PRESERVED '교체 실패; 기존 ROM 재검증 성공, 백업 보존' 1
    return 1
  fi
  if ! rom_verify_bytes "$serial" "$ROM_BACKUP" "$ROM_OLD_SIZE" "$ROM_OLD_HASH"; then
    rom_failure "$serial" RECOVERY_REQUIRED '백업 재검증 실패; 자동 복원 중단' 1; return 1
  fi
  if ! rom_remote_action "$serial" RESTORE_COPY || ! rom_verify_bytes "$serial" "$ROM_RESTORE" "$ROM_OLD_SIZE" "$ROM_OLD_HASH"; then
    rom_failure "$serial" RECOVERY_REQUIRED '복원용 사본 생성/검증 실패; 원본 백업 보존' 1; return 1
  fi
  # Verify final bytes even when the mv reply is lost or reports an error.
  rom_remote_action "$serial" RESTORE || true
  if ! adb_connection_alive "$serial"; then rom_failure "$serial" UNKNOWN '복원 직후 연결 단절; 복원 결과 불명' 1; return 1; fi
  if rom_verify_bytes "$serial" "$ROM_FINAL" "$ROM_OLD_SIZE" "$ROM_OLD_HASH"; then
    rom_failure "$serial" FAILED_RESTORED '교체 실패 후 기존 ROM 크기/SHA-256 복원 검증 성공; 백업 보존' 1
  else
    rom_failure "$serial" RECOVERY_REQUIRED '복원 후 최종 ROM 검증 실패; 수동 복구 필요, 원본 백업 보존' 1
  fi
  return 1
}

push_rom_verified() {
  local serial="$1" local_file="$2" remote_file="$3" expected_size="$4" expected_hash="$5"
  local state old_exists=0 space space_check failure_status=FAILED_PRESERVED
  ROM_REPLACE_STATUS=FAILED_PRESERVED
  ROM_RECOVERY_REQUIRED=0
  ROM_RECOVERY_REPORT=""
  ROM_OLD_SIZE=unknown; ROM_OLD_HASH=unknown
  ROM_NEW_SIZE="$expected_size"; ROM_NEW_HASH="$expected_hash"
  rom_artifact_paths "$remote_file" || return 1
  [[ "$expected_size" =~ ^[0-9]+$ && "$expected_hash" =~ ^[0-9a-f]{64}$ ]] || { rom_failure "$serial" FAILED_PRESERVED '원본 ROM 검증값 오류'; return 1; }
  state="$(rom_remote_probe "$serial")" || { rom_failure "$serial" FAILED_PRESERVED '기존 ROM 상태 조회 실패'; return 1; }
  if [[ "$state" == BUSY ]]; then rom_failure "$serial" PENDING '미완료 트랜잭션/기존 백업 발견; 자동 덮어쓰기 중단' 1; return 1; fi
  if [[ "$state" == FILE\ * ]]; then
    old_exists=1; ROM_OLD_SIZE="${state#FILE }"
    ROM_OLD_HASH="$(remote_sha256 "$serial" "$remote_file" "$ROM_OLD_SIZE")" || { rom_failure "$serial" FAILED_PRESERVED '기존 ROM 해시 검증 실패'; return 1; }
  else
    ROM_OLD_SIZE=0; ROM_OLD_HASH=-; failure_status=FAILED_NEW
  fi
  space="$(rom_remote_space "$serial")" || { rom_failure "$serial" "$failure_status" '여유 공간 조회 실패'; return 1; }
  space_check="$(python3 - "$space" "$ROM_OLD_SIZE" "$expected_size" <<'PY'
import re, sys
m = re.fullmatch(r'ESDE_ROM_SPACE_V1 ([0-9]+) ([0-9]+)', sys.argv[1])
if not m or int(m[2]) == 0: raise SystemExit(2)
available = int(m[1]) * int(m[2])
old, new = int(sys.argv[2]), int(sys.argv[3])
# Reserve restore-copy bytes and possible final growth if mv leaves part + final.
required = 2 * old + new + max(0, new - old) + 1024 * 1024
print(f'available={available} required={required}')
raise SystemExit(0 if available >= required else 1)
PY
)" || { rom_failure "$serial" "$failure_status" "여유 공간 부족 또는 응답 오류: $space_check"; return 1; }
  if ! rom_remote_action "$serial" CLAIM; then rom_failure "$serial" PENDING '트랜잭션 독점 확보/메타데이터 기록 실패; 잔재 확인 필요' 1; return 1; fi
  printf 'ROM TRANSACTION: %s | backup=%s | metadata=%s/old.meta | old_size=%s old_sha256=%s\n' "$remote_file" "$ROM_BACKUP" "$ROM_TXN" "$ROM_OLD_SIZE" "$ROM_OLD_HASH" >>"$LOG_FILE"
  if [[ "$old_exists" == 1 ]]; then
    if ! rom_remote_action "$serial" BACKUP || ! rom_verify_bytes "$serial" "$ROM_BACKUP" "$ROM_OLD_SIZE" "$ROM_OLD_HASH" || ! rom_verify_bytes "$serial" "$remote_file" "$ROM_OLD_SIZE" "$ROM_OLD_HASH"; then
      rom_failure "$serial" "$failure_status" '백업 생성/검증 실패; 기존 ROM 변경하지 않음' 1; return 1
    fi
  fi
  if ! adb_connection_alive "$serial" || ! adb -s "$serial" push "$local_file" "$ROM_PART" </dev/null >>"$LOG_FILE" 2>&1; then
    rom_failure "$serial" "$failure_status" '새 ROM 전송 실패; 원본 경로와 트랜잭션 파일 보존' 1; return 1
  fi
  if ! rom_verify_bytes "$serial" "$ROM_PART" "$expected_size" "$expected_hash"; then
    rom_failure "$serial" "$failure_status" '새 ROM 임시 파일 검증 실패; 원본 경로와 트랜잭션 파일 보존' 1; return 1
  fi
  if [[ "$old_exists" == 1 ]]; then
    if ! rom_verify_bytes "$serial" "$remote_file" "$ROM_OLD_SIZE" "$ROM_OLD_HASH"; then
      rom_failure "$serial" "$failure_status" '전송 중 기존 ROM 변경/검증 실패; 덮어쓰기 중단' 1; return 1
    fi
  else
    state="$(rom_remote_probe "$serial" 0)" || state=ERROR
    if [[ "$state" != MISSING ]]; then rom_failure "$serial" "$failure_status" '신규 경로에 파일 발생/상태 불명; 덮어쓰기 중단' 1; return 1; fi
  fi
  rom_remote_action "$serial" REPLACE || true
  if ! adb_connection_alive "$serial"; then rom_failure "$serial" UNKNOWN '교체 직후 연결 단절; 최종 결과 불명, 백업 보존' 1; return 1; fi
  if rom_verify_bytes "$serial" "$remote_file" "$expected_size" "$expected_hash"; then
    if ! rom_remote_action "$serial" CLEAN; then rom_failure "$serial" COMMITTED_CLEANUP_FAILED '최종 ROM 검증 성공; 트랜잭션 정리 미완료' 1; return 1; fi
    ROM_REPLACE_STATUS=SUCCESS
    printf 'ROM REPLACE SUCCESS (size/SHA-256 verified): %s\n' "$remote_file" >>"$LOG_FILE"
    return 0
  fi
  if [[ "$old_exists" == 1 ]]; then rom_restore_backup "$serial"
  else rom_failure "$serial" RECOVERY_REQUIRED '신규 ROM 최종 검증 실패; 복원할 기존 ROM 없음, 파일 보존' 1; fi
  return 1
}

# Scan directories as well as files: a kill immediately after mkdir may leave
# an empty txn that the regular file index cannot see. Never auto-resolve it.
rom_pending_transactions() {
  local serial="$1" remote_dir="$2" script response result rc
  response="$TMP_DIR/rom-pending-${BASHPID}-${RANDOM}.bin"
  script="p=$(remote_shell_quote "$remote_dir")
$(cat <<'SH'
if [ ! -e "$p" ] && [ ! -L "$p" ]; then printf 'ESDE_ROM_PENDING_V1 EMPTY\n'; exit 0; fi
if [ ! -d "$p" ] || [ ! -r "$p" ] || [ ! -x "$p" ]; then printf 'ESDE_ROM_PENDING_V1 ERROR\n'; exit 0; fi
printf 'ESDE_ROM_PENDING_V1 BEGIN\n'
find "$p" \( -name '.esde-sync-*' -o -name '.*.esde-sync-part-*' \) -exec sh -c '
  n=$(printf "%s" "$1" | wc -c | tr -d "[:space:]")
  case "$n" in ""|*[!0-9]*) printf "ERROR\n"; exit 0;; esac
  printf "P %s\n" "$n"
  printf "%s" "$1"
' sh {} \; 2>/dev/null
rc=$?
if [ "$rc" = 0 ]; then printf 'ESDE_ROM_PENDING_V1 END\n'; else printf 'ESDE_ROM_PENDING_V1 ERROR\n'; fi
SH
)"
  adb -s "$serial" exec-out "$script" </dev/null >"$response" 2>>"$LOG_FILE" || true
  result="$(python3 - "$response" "$remote_dir/" <<'PY'
import json, os, pathlib, re, sys
raw = pathlib.Path(sys.argv[1]).read_bytes()
if raw == b'ESDE_ROM_PENDING_V1 EMPTY\n':
    print('[]'); raise SystemExit(0)
start, end = b'ESDE_ROM_PENDING_V1 BEGIN\n', b'ESDE_ROM_PENDING_V1 END\n'
if not raw.startswith(start): raise SystemExit(2)
pos, paths = len(start), []
while raw[pos:] != end:
    nl = raw.find(b'\n', pos, pos + 128)
    if nl < 0: raise SystemExit(2)
    m = re.fullmatch(rb'P ([0-9]+)', raw[pos:nl])
    if not m: raise SystemExit(2)
    n = int(m[1]); pos = nl + 1
    path = raw[pos:pos+n]; pos += n
    if n == 0 or len(path) != n or b'\0' in path or not path.startswith(os.fsencode(sys.argv[2])) or path in paths: raise SystemExit(2)
    paths.append(path)
print(json.dumps([os.fsdecode(p) for p in paths], ensure_ascii=False))
raise SystemExit(1 if paths else 0)
PY
)"; rc=$?
  rm -f "$response"
  printf '%s\n' "$result"
  return "$rc"
}

# Return codes: 0 = identical, 1 = upload/update required, 2 = unverifiable.
# ROM_LOCAL_HASH and ROM_LOCAL_SIZE contain the stable local snapshot metadata.
rom_compare() {
  local serial="$1" local_file="$2" remote_file="$3" remote_file_size="$4" local_size remote_hash
  local state
  ROM_RECOVERY_REQUIRED=0
  ROM_RECOVERY_REPORT=""
  ROM_OLD_SIZE=unknown; ROM_OLD_HASH=unknown
  rom_artifact_paths "$remote_file" || return 2
  state="$(rom_remote_probe "$serial")" || {
    rom_failure "$serial" FAILED_PRESERVED 'ROM 교체 잔재/상태 확인 실패'
    return 2
  }
  if [[ "$state" == BUSY ]]; then
    rom_failure "$serial" PENDING '미완료 트랜잭션/기존 백업 발견; 동일 ROM도 건너뛰지 않고 중단' 1
    return 2
  fi
  local_size="$(stat -c '%s' -- "$local_file")" || return 2
  ROM_LOCAL_HASH="$(local_sha256 "$local_file")" || return 2
  ROM_LOCAL_SIZE="$local_size"
  if [[ -z "$remote_file_size" || "$remote_file_size" != "$local_size" ]]; then
    return 1
  fi
  remote_hash="$(remote_sha256 "$serial" "$remote_file" "$remote_file_size")" || return 2
  [[ "$ROM_LOCAL_HASH" == "$remote_hash" ]] && return 0
  return 1
}

